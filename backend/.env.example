# =============================================================================
# Backend (FastAPI) — deploy target: Render / Railway / any Docker host
#
# Root Directory for this service: `backend`
# On Render these are set under Service → Environment (never committed).
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# Neon/Supabase give you a libpq URL. Two edits are mandatory:
#   1. scheme must be postgresql+asyncpg://   (not postgresql://)
#   2. delete the ?sslmode=...&channel_binding=... tail — asyncpg rejects those
#      libpq options and the app boot-loops with only a TypeError to show for it
# Use the DIRECT endpoint, not the pooled one: PgBouncer in transaction mode
# breaks the prepared statements SQLAlchemy's asyncpg driver relies on.
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Optional: a non-owner Postgres login that makes the row-level-security
# policies bite. Leave it blank and startup creates no role — the policies are
# still installed, they just don't apply to an owner connection.
# To enable: set a STRONG password (managed providers reject weak ones — Neon
# answers with "insecure password, try including more special characters"),
# let the app boot once to create the role, then repoint DATABASE_URL at it.
# DB_APP_ROLE=cms_app
# DB_APP_ROLE_PASSWORD=

# --- Security (REQUIRED) -----------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- URLs (REQUIRED) ---------------------------------------------------------
# Public URL of THIS service. OAuth redirect URIs derive from it.
BACKEND_URL=https://your-api.onrender.com
# Where email links point (the editor app).
FRONTEND_URL=https://your-editor.vercel.app
# Exact browser origins allowed to call this API. Comma-separated.
# No trailing slashes — a mismatch here is the usual cause of "login does nothing".
CORS_ORIGINS=https://your-editor.vercel.app,https://your-preview.vercel.app,https://your-admin.vercel.app

# --- Dev-mode switches (MUST be false in any hosted environment) -------------
# true returns verification/reset tokens in API responses — anyone could then
# verify any address.
AUTH_DEV_MODE=false
# true allows switching plans without Stripe; any user with manage_settings
# could grant themselves the top plan.
BILLING_DEV_MODE=true

# --- Outbound email ----------------------------------------------------------
# Verification, password reset and invitations.
# Transport: resend | brevo | smtp | log. Leave empty to auto-detect in that
# order. With no provider at all, emails are only written to the server log and
# users never receive anything.
MAIL_PROVIDER=

# Sender address. Its DOMAIN must be verified with your provider, or sending
# fails with a 403. Resend's onboarding@resend.dev works for testing.
MAIL_FROM=Ondros CMS <onboarding@resend.dev>

# Option A — Resend (recommended; free tier, HTTP API, no SMTP ports needed)
# https://resend.com/api-keys
RESEND_API_KEY=

# Option B — Brevo (free tier, HTTP API)
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Option C — any SMTP relay (Mailgun, SendGrid, Gmail, self-hosted).
# Some PaaS hosts block or throttle outbound SMTP; prefer an HTTP provider there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Social login (optional) -------------------------------------------------
# Register each app's redirect URI as {BACKEND_URL}/sso/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Ondros Code Sync (optional) ---------------------------------------------
# Connects a space to the GitHub repository that renders its site, so the
# editor previews YOUR pages and components instead of a generic rendering.
# Leave empty and the editor says Code Sync isn't set up — everything else
# works, but entry previews have nothing to load.
#
# NOT the GITHUB_CLIENT_ID/_SECRET above: those sign people in, these read
# repositories. Register a separate GitHub App ("Ondros Code Sync") with
# Contents + Metadata read-only, subscribed to Push, and:
#   Setup URL     {BACKEND_URL}/code-sync/github/callback   (NOT 'Redirect URI')
#   Webhook URL   {BACKEND_URL}/code-sync/github/webhook
# Walkthrough: docs/20-code-sync.md
GITHUB_APP_ID=
GITHUB_APP_SLUG=ondros-code-sync
# The PEM itself. Most dashboards mangle multi-line values, so either escape
# the newlines as \n or paste a base64 copy of the whole file — both are
# accepted.
GITHUB_APP_PRIVATE_KEY=
# Verifies POST /code-sync/github/webhook. Unset means EVERY webhook is
# rejected, so pushes won't re-sync the component manifest.
GITHUB_APP_WEBHOOK_SECRET=
# Local development only: a personal access token used when no App is
# configured. It carries its owner's full account access, so leave it empty in
# any hosted environment.
GITHUB_TOKEN=
# Change only for GitHub Enterprise Server.
GITHUB_API_URL=https://api.github.com

# --- Billing (optional) ------------------------------------------------------
# Required when BILLING_DEV_MODE=false.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI (optional) -----------------------------------------------------------
# Empty = AI endpoints return 503; everything else works.
# groq | gemini | ollama | openrouter | openai | azure_openai
# Leave AI_PROVIDER empty to detect it from the key's prefix (gsk_ -> groq,
# AIza -> gemini, sk-or- -> openrouter, sk- -> openai). The chat model is
# discovered the same way: Ondros asks the key what it can use, so a retired
# model does not need a config change. Set AI_CHAT_MODEL only to pin one.
AI_PROVIDER=
AI_API_KEY=
# 1536 for OpenAI/Azure, 768 for Gemini/Ollama.
# FIXED when the pgvector column is first created — set it before any ingest.
EMBEDDING_DIM=1536

# --- Misc --------------------------------------------------------------------
LOG_LEVEL=INFO
MEDIA_ROOT=media

# =============================================================================
# Preview site (Next.js) — deploy target: Vercel
#
# Root Directory for this project: `preview`
#
# A reference consumer of the delivery API. Replace it with your real site and
# keep the data-cms-* attributes if you want inline editing to keep working.
#
# Note the two API URLs: server-side rendering and the browser reach the
# backend over different networks.
# =============================================================================

# --- Required ----------------------------------------------------------------
# Server-side fetches (SSR / route handlers). NOT exposed to the browser.
# In Docker this is http://backend:8000; hosted, it's the public API URL.
CMS_API_URL=https://your-api.onrender.com

# Browser-side use: WebSocket live preview and media URLs.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# --- API keys (REQUIRED) -----------------------------------------------------
# Created in the editor under Settings → API keys.
# Deliberately NOT NEXT_PUBLIC_*: these stay server-side.

# cms_del_... — published content only. Safe for public traffic.
CMS_DELIVERY_TOKEN=

# cms_pre_... — includes drafts. Used only when Next.js draft mode is on.
CMS_PREVIEW_TOKEN=

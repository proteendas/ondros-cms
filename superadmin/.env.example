# =============================================================================
# Superadmin portal (Next.js) — deploy target: Vercel
#
# Root Directory for this project: `superadmin`
#
# Operator dashboard spanning ALL tenants. Access needs a user with
# is_platform_admin = true; there is no API-key path in.
#
# Deploy it separately from the editor so it can be firewalled, IP-restricted
# or kept off a public domain entirely.
# =============================================================================

# --- Required ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# Where impersonation sessions open — the editor app.
NEXT_PUBLIC_EDITOR_URL=https://your-editor.vercel.app

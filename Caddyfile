{
  # Plain HTTP for now — Let's Encrypt refuses to issue certs for
  # *.compute.amazonaws.com hostnames ("forbidden by policy"), so automatic
  # HTTPS is off until this points at a real domain you control. Once it
  # does: remove this block, drop the ":80" from each site below, and Caddy
  # will obtain real certs automatically.
  auto_https off
}

app.{$PUBLIC_HOST}:80 {
  reverse_proxy editor:3000
}
api.{$PUBLIC_HOST}:80 {
  reverse_proxy backend:8000
}
preview.{$PUBLIC_HOST}:80 {
  reverse_proxy preview:3001
}
{$PUBLIC_HOST}:80 {
  reverse_proxy marketing:3002
}
admin.{$PUBLIC_HOST}:80 {
  reverse_proxy superadmin:3003
}

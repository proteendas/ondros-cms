{
  # Plain HTTP, port-based routing — the raw AWS public DNS hostname has no
  # subdomain DNS behind it (no app./api./etc. records exist, and can't),
  # so each service gets its own port on the one hostname that does resolve.
  # Also why auto_https is off: Let's Encrypt refuses certs for
  # *.compute.amazonaws.com by policy anyway. Once this points at a real
  # domain you own, subdomain routing + automatic HTTPS both become options
  # again — ask for that Caddyfile if/when you get a domain.
  auto_https off
}

http://{$PUBLIC_HOST}:3000 {
  reverse_proxy editor:3000
}
http://{$PUBLIC_HOST}:8000 {
  reverse_proxy backend:8000
}
http://{$PUBLIC_HOST}:3001 {
  reverse_proxy preview:3001
}
http://{$PUBLIC_HOST}:3002 {
  reverse_proxy marketing:3002
}
http://{$PUBLIC_HOST}:3003 {
  reverse_proxy superadmin:3003
}

# Copy to .env — consumed by docker-compose.yml (and by backend/.env if running bare).

# Security
JWT_SECRET=dev-jwt-secret-change-me

# ---------------------------------------------------------------------------
# Accounts & email (spec 001)
# AUTH_DEV_MODE=true returns verification/reset/invite tokens in API responses
# and logs email bodies instead of sending — NEVER enable in production.
# ---------------------------------------------------------------------------
AUTH_DEV_MODE=true
FRONTEND_URL=http://localhost:3000

# Marketing site (spec 009): where its Login / Get Started CTAs redirect.
APP_LOGIN_URL=http://localhost:3000/login
APP_SIGNUP_URL=http://localhost:3000/signup
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASSWORD=
#SMTP_FROM=Ondros CMS <no-reply@yourdomain.com>

# ---------------------------------------------------------------------------
# Social OAuth (specs 002 + 012) — "Continue with Google/GitHub/Microsoft"
# buttons on the login page. Unknown emails get a personal account (JIT).
# Register the apps with redirect URI {BACKEND_URL}/sso/<provider>/callback
# (Google Cloud Console / GitHub Developer Settings / Azure portal).
# Per-account enterprise SSO is configured in Settings > Security instead.
# ---------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT=common

# ---------------------------------------------------------------------------
# Billing (spec 005) — BILLING_DEV_MODE allows plan switching without Stripe.
# ---------------------------------------------------------------------------
BILLING_DEV_MODE=true
#STRIPE_SECRET_KEY=
#STRIPE_WEBHOOK_SECRET=

# Dev API tokens (the seed script creates keys with these exact tokens so the
# preview app works out of the box; rotate for anything public).
SEED_DELIVERY_TOKEN=cms_del_dev-delivery-token-0000
SEED_PREVIEW_TOKEN=cms_pre_dev-preview-token-0000

# ---------------------------------------------------------------------------
# AI provider — pick ONE. Free options first. Leave AI_PROVIDER empty to
# disable AI features (endpoints return 503; everything else works).
# ---------------------------------------------------------------------------

# Option A: Groq (FREE tier, very fast — https://console.groq.com)
#   Chat-only: guideline retrieval automatically uses keyword search.
#AI_PROVIDER=groq
#AI_API_KEY=gsk_...

# Option B: Google Gemini (FREE tier — https://aistudio.google.com/apikey)
#   Supports embeddings too; set EMBEDDING_DIM=768 *before first ingest*.
#AI_PROVIDER=gemini
#AI_API_KEY=AIza...
#EMBEDDING_DIM=768

# Option C: Ollama (100% local & free — https://ollama.com; run `ollama serve`,
#   `ollama pull llama3.1`, `ollama pull nomic-embed-text`)
#   From docker-compose, the backend reaches your host via host.docker.internal.
#AI_PROVIDER=ollama
#AI_BASE_URL=http://host.docker.internal:11434/v1
#EMBEDDING_DIM=768

# Option D: OpenRouter (free models available — https://openrouter.ai)
#AI_PROVIDER=openrouter
#AI_API_KEY=sk-or-...

# Option E: OpenAI (paid)
#AI_PROVIDER=openai
#AI_API_KEY=sk-...

# Option F: Azure OpenAI (paid)
#AI_PROVIDER=azure_openai
#AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
#AZURE_OPENAI_API_VERSION=2024-06-01
#AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
#AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Optional overrides for any provider:
#AI_CHAT_MODEL=            # e.g. llama-3.3-70b-versatile / gemini-2.0-flash
#AI_EMBEDDING_MODEL=       # "none" disables embeddings (keyword retrieval)
#AI_BASE_URL=              # custom OpenAI-compatible endpoint

# pgvector column size — must match the embedding model's output dimension.
# 1536 = OpenAI text-embedding-3-small; 768 = Gemini text-embedding-004 /
# Ollama nomic-embed-text. Changing it after guideline ingestion requires
# dropping the guideline_chunks table (or docker compose down -v).
EMBEDDING_DIM=1536

# =============================================================================
# Editor (Next.js) — deploy target: Vercel
#
# Root Directory for this project: `editor`
#
# NEXT_PUBLIC_* values are INLINED INTO THE BROWSER BUNDLE AT BUILD TIME.
#   - changing one in the dashboard does nothing until you REDEPLOY
#   - never put a secret in one; it ships to every visitor
# =============================================================================

# --- Required ----------------------------------------------------------------
# Public URL of the backend API.
NEXT_PUBLIC_API_URL=https://your-api.onrender.com

# --- Live preview (optional) -------------------------------------------------
# The preview site shown in the editor's split view.
NEXT_PUBLIC_PREVIEW_URL=https://your-preview.vercel.app

# A cms_pre_... key, created in the editor under Settings → API keys.
# NOTE: this ships to the browser, so anyone using the editor can read it and
# fetch unpublished content. Acceptable for a demo; for a hardened deployment,
# mint short-lived preview keys server-side instead.
NEXT_PUBLIC_PREVIEW_TOKEN=

# --- Contact details shown on /support and /legal/* (optional) ---------------
# All default to a single fallback address if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=

# --- Legal entity shown on the policy pages (optional) -----------------------
# Fill these in before anyone relies on the published policies.
NEXT_PUBLIC_LEGAL_COMPANY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_JURISDICTION=
